# GitHub Actions secrets template
# Add these as repository/environment secrets in GitHub Settings > Secrets.
# Never commit real values.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Dev environment
DEV_EC2_HOST=
DEV_EC2_USER=ec2-user
DEV_EC2_SSH_KEY=

# Production environment
PROD_EC2_HOST=
PROD_EC2_USER=ec2-user
PROD_EC2_SSH_KEY=
