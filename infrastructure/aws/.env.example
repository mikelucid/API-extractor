# AWS credentials and configuration
# Copy to .env and fill in real values. Never commit .env to git.

AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_REGION=us-east-1

# EC2 configuration
EC2_KEY_NAME=your-ec2-keypair-name
EC2_INSTANCE_TYPE=t3.small
EC2_AMI_ID=ami-0c02fb55956c7d316

# Dev environment
DEV_EC2_HOST=1.2.3.4
DEV_EC2_USER=ec2-user
# DEV_EC2_SSH_KEY — set as GitHub Actions secret

# Prod environment
PROD_EC2_HOST=5.6.7.8
PROD_EC2_USER=ec2-user
# PROD_EC2_SSH_KEY — set as GitHub Actions secret

# ECR
ECR_REPOSITORY=rootagentv2-web
